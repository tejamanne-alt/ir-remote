  "fixed_sql": [
    {
      "name": "rooms",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rooms\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "devices",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"devices\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"brand\" TEXT NULL, \"code_set_id\" TEXT NULL, \"room_id\" INTEGER NULL REFERENCES rooms (id) ON DELETE SET NULL, \"transport_id\" TEXT NULL, \"favourite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"favourite\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" TEXT NOT NULL, \"last_used_at\" TEXT NULL, \"ac_protocol_id\" TEXT NULL, \"ac_caps_version\" INTEGER NULL, \"ac_last_state\" TEXT NULL, \"ac_last_sent_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "device_keys",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"device_keys\" (\"device_id\" TEXT NOT NULL REFERENCES devices (id) ON DELETE CASCADE, \"key_name\" TEXT NOT NULL, \"label\" TEXT NULL, \"signal\" TEXT NOT NULL, \"signal_toggled\" TEXT NULL, \"source\" TEXT NOT NULL, \"protocol\" TEXT NULL, \"params\" TEXT NULL, \"position\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"device_id\", \"key_name\"));"
        }
      ]
    },
    {
      "name": "hubs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"hubs\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"host\" TEXT NOT NULL, \"port\" INTEGER NOT NULL, \"token\" TEXT NULL, \"extra\" TEXT NULL, \"added_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "macros",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"macros\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"steps\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
